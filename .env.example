# Copy to `.env` and fill in. `.env` is gitignored -- never commit real keys.

# ---- Benchmark data -------------------------------------------------------
# tau2 is installed as a library, so its data/ directory (which lives at the
# upstream repo root, outside the package) is not on disk by default. Point
# this at a checkout of that directory; `python scripts/bootstrap_data.py`
# creates one under vendor/. Must contain `tau2/domains/<domain>/`.
# Simulation results are also written here, to `<TAU2_DATA_DIR>/simulations/`.
TAU2_DATA_DIR=vendor/tau2-data/data

# ---- Model providers ------------------------------------------------------
# Two independent paths use these keys:
#   * our sub-agents      -> pydantic-ai, configured by STEWARD_LLM_* below
#   * tau2's user simulator -> LiteLLM, configured by `tau2 run --llm-user`
# Only the providers you actually use need a key.
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ---- Steward model defaults ---------------------------------------------------
# Agents choose their own model by argument (`llm.get_model(...)`); these are
# only the fallback for whatever an agent leaves unset. Check a model first:
#   uv run python scripts/probe_models.py check --model <id>
STEWARD_LLM_PROVIDER=nvidia
STEWARD_LLM_MODEL=
# Deterministic by default: reward is binary per task and pass^k counts a task
# only when every trial passes, so sampling variance is a direct score loss.
STEWARD_LLM_TEMPERATURE=0.0
STEWARD_LLM_TIMEOUT=120
STEWARD_LLM_MAX_TOKENS=
# Open-weight reasoning models think for a very long time by default:
# gpt-oss-120b answers a one-word prompt in 3s at `low` and times out past 300s
# at `medium`. Leave empty for non-reasoning models.
STEWARD_LLM_REASONING_EFFORT=

# ---- Optional -------------------------------------------------------------
# Voice / full-duplex domains only (not used by the text-only setup):
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=

# ---- Tracing --------------------------------------------------------------
# Every model call and every graph node goes to Langfuse when these are set;
# leave them empty and tracing is off. `LANGFUSE_TRACING_ENABLED=false` turns it
# off without removing the keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Model for the write-gating critic. Unset means it runs on the same model as
# the actor (--agent-llm), which is the configuration to beat before paying for
# a stronger one.
STEWARD_GATE_MODEL=

# The record-selection stage: an extractor copies out how the customer described
# the reservation ("only one passenger"), and a deterministic check compares that
# against the record the write points at. Costs one model call per write proposal
# the free checks have already cleared. `on` turns it on; anything else is off.
STEWARD_SELECT=

# The monolithic critic. `on` consults it after the deterministic checks; off by
# default because the two 50-task arms differing only in this flag came out
# inside the run-to-run noise.
STEWARD_GATE=
